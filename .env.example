# ---------------------------------------------------------------------------
# CV Pro: environment variables
#
# Copy this file to ".env.local" and fill in the values:
#     copy .env.example .env.local        (Windows)
#     cp .env.example .env.local          (macOS / Linux)
#
# ".env.local" is ignored by Git. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Public URL of the site (optional). Used for canonical links and the sitemap.
# Example in production: https://cvpro.ma
NEXT_PUBLIC_SITE_URL=

# Supabase (needed only for accounts; without it the app works as before,
# anonymously, with the local draft).
# Find both values in the Supabase dashboard: "Connect" dialog, or
# Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# WARNING: never put a "secret" key (sb_secret_...) or a legacy "service_role"
# key in a variable starting with NEXT_PUBLIC_. Those variables are sent to every
# visitor's browser. The app refuses to start auth if it detects one.
